---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CV | Manuel Jiménez"
  description="Professional CV of Manuel Jiménez, a Software Developer with experience in web development, systems and automation."
  lang="en"
>
  <article class="cv-page">
    <header class="cv-header">
      <div>
        <p class="eyebrow">CURRICULUM VITAE</p>

        <p class="cv-name">Manuel Jiménez</p>

        <h1>Software Developer</h1>

        <p class="intro">
          A profile focused on software development, web applications, backend
          development, automation and IT environments.
        </p>
      </div>

      <div class="cv-actions">
        <a class="button button-primary" href="#experience">
          View experience
        </a>

        <a class="button button-secondary" href="/en/contact/">
          Get in touch
        </a>
      </div>
    </header>

    <div class="cv-content">
      <section id="experience" class="cv-section">
        <header class="section-header">
          <p class="section-label">EXPERIENCE</p>
          <h2>Professional experience</h2>
        </header>

        <div class="timeline">
          <article class="timeline-item">
            <div class="timeline-heading">
              <div>
                <h3>IT Systems Operations Technician</h3>
                <p>UNED Madrid</p>
              </div>

              <span>≈ 1 year</span>
            </div>

            <ul>
              <li>
                Participation in the digital modernization of internal processes
                through automation and improvements to technology platforms.
              </li>
              <li>
                Automation of administrative processes using Microsoft Power
                Automate, reducing manual intervention in repetitive tasks and
                improving operational efficiency.
              </li>
              <li>
                Migration and redesign of the institutional portal and intranet,
                moving from WordPress to Magnolia CMS.
              </li>
              <li>
                Work with Magnolia CMS to configure and customize pages,
                components, templates, content, navigation and forms.
              </li>
              <li>
                Development and improvement of internal web platforms, including
                participation in the technical SEO optimization of the
                institutional portal.
              </li>
              <li>
                Preparation of technical documentation and user manuals related
                to digitized systems and processes.
              </li>
              <li>
                Evaluation of hardware and software solutions to optimize
                internal processes and support the organization's technological
                evolution.
              </li>
              <li>
                Technical support and incident resolution for internal systems
                and platforms.
              </li>
            </ul>
          </article>

          <article class="timeline-item">
            <div class="timeline-heading">
              <div>
                <h3>Web Application Developer</h3>
                <p>ESMASA (Internship)</p>
              </div>

              <span>3 months</span>
            </div>

            <ul>
              <li>
                Participation in the development of a web application for
                document digitization and management.
              </li>
              <li>
                Development with HTML, CSS, JavaScript, Bootstrap, jQuery and
                DataTables.
              </li>
              <li>
                Work with PHP and MySQL for application and data management.
              </li>
              <li>
                Use of Google Apps Script and Google Drive within the document
                management workflow.
              </li>
              <li>
                Work with the local environment and the configuration required
                to run the application.
              </li>
            </ul>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">EDUCATION</p>
          <h2>Academic education</h2>
        </header>

        <div class="education-list">
          <article class="education-item">
            <h3>Multiplatform Application Development</h3>
            <p>
              IES Gabriel García Márquez · Higher Technician qualification · DAM
            </p>
          </article>

          <article class="education-item">
            <h3>Master Full Stack Development</h3>
            <p>MasterD · Specialized non-official training</p>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">SKILLS</p>
          <h2>Technical areas</h2>
        </header>

        <div class="skills-grid">
          <article>
            <h3>Development</h3>
            <p>Java · Kotlin · Python · JavaScript · PHP · HTML · CSS · XML</p>
          </article>

          <article>
            <h3>Web &amp; Backend</h3>
            <p>
              Spring Boot · Bootstrap · jQuery · DataTables · REST APIs · AJAX ·
              JSON
            </p>
          </article>

          <article>
            <h3>Databases</h3>
            <p>SQL · MySQL · MySQL Workbench · Firebase</p>
          </article>

          <article>
            <h3>Automation</h3>
            <p>Microsoft Power Automate · Google Apps Script</p>
          </article>

          <article>
            <h3>CMS &amp; Platforms</h3>
            <p>Magnolia · WordPress · SharePoint · Joomla</p>
          </article>

          <article>
            <h3>Tools &amp; Systems</h3>
            <p>
              Git · GitHub · Postman · XAMPP · Apache · VirtualBox · PowerShell
            </p>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">PROJECTS</p>
          <h2>Selected projects</h2>
        </header>

        <div class="projects-list">
          <article>
            <h3>Document Management and Digitization</h3>

            <p>
              Professional project involving the development of a web
              application for document digitization and management.
            </p>

            <a href="/en/projects/document-management/"> View project </a>
          </article>

          <article>
            <h3>Android Tourism Application</h3>

            <p>
              Academic project involving a mobile application for creating
              personalized tourist routes in Madrid.
            </p>

            <a href="/en/projects/android-tourism/"> View project </a>
          </article>

          <article>
            <h3>Request Management Automation</h3>

            <p>
              Automation of an internal process using Microsoft Forms, Microsoft
              Lists and Power Automate.
            </p>

            <a href="/en/projects/power-automate/"> View project </a>
          </article>

          <article>
            <h3>Institutional Portal Redesign and Migration</h3>

            <p>
              Professional work with Magnolia CMS to reorganize and migrate
              content within a new institutional portal.
            </p>

            <a href="/en/projects/magnolia/"> View project </a>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">LEARNING</p>
          <h2>Additional training</h2>
        </header>

        <ul class="course-list">
          <li>Java and Object-Oriented Programming · Mouredev</li>
          <li>Python Essentials 1 · Cisco</li>
          <li>Python Essentials 2 · Cisco</li>
          <li>JavaScript Essentials 1 · Cisco</li>
          <li>Introduction to Web Development · Google</li>
          <li>Introduction to Mobile Application Development · Google</li>
          <li>Excel</li>
          <li>Prompt Engineering</li>
          <li>Responsible AI &amp; Prompt Engineering</li>
          <li>Cybersecurity for Remote Work</li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .cv-page {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 4rem 6rem;
  }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-header > div:first-child {
    max-width: 800px;
  }

  .eyebrow,
  .section-label {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .cv-name {
    margin-bottom: 0.75rem;
    color: var(--color-text);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .cv-header h1 {
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 700px;
    font-size: 1.2rem;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button-secondary:hover {
    background: var(--color-surface-subtle);
  }

  .cv-content {
    max-width: 1000px;
  }

  .cv-section {
    padding-block: 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    margin: 0;
  }

  .timeline {
    display: grid;
    gap: 3rem;
  }

  .timeline-item {
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .timeline-heading h3 {
    margin-bottom: 0.4rem;
  }

  .timeline-heading p,
  .timeline-heading span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .timeline-heading span {
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .timeline-item ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .timeline-item li + li {
    margin-top: 0.6rem;
  }

  .education-list {
    display: grid;
    gap: 1rem;
  }

  .education-item {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .education-item h3 {
    margin-bottom: 0.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .skills-grid article {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .skills-grid h3 {
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .projects-list article {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .projects-list h3 {
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .projects-list p {
    margin-bottom: 1rem;
  }

  .projects-list a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .projects-list a:hover {
    color: var(--color-primary-hover);
  }

  .course-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .course-list li {
    padding-block: 0.25rem;
  }

  @media (max-width: 800px) {
    .cv-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .skills-grid,
    .projects-list,
    .course-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cv-page {
      padding-block: 3rem 5rem;
    }

    .cv-header {
      padding-bottom: 3rem;
    }

    .cv-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .cv-section {
      padding-block: 3rem;
    }

    .timeline-heading {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
