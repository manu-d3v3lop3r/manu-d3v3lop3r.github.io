---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectCard from "../../../components/projects/ProjectCard.astro";

const projects = await getCollection(
  "projects",
  ({ data }) => data.language === "en",
);

const sortedProjects = projects.sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);

const projectTypeLabels = {
  professional: "Professional",
  academic: "Academic",
  personal: "Personal",
} as const;
---

<BaseLayout
  title="Projects | Portfolio"
  description="Professional, academic and personal projects by a Software Developer."
  lang="en"
>
  <section class="projects-page">
    <header class="page-header">
      <p class="eyebrow">PROJECTS</p>

      <h1>Projects</h1>

      <p>
        A selection of professional, academic and personal projects, explained
        from the problem to the solution and technical decisions.
      </p>
    </header>

    <div class="projects-list">
      {
        sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            type={projectTypeLabels[project.data.type]}
            technologies={project.data.technologies}
            technologiesLabel="Technologies used"
            href={`/en/projects/${project.data.routeSlug ?? project.data.slug}/`}
            linkLabel="View project"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 4rem;
  }

  .page-header {
    max-width: 800px;
    margin-bottom: 4rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .page-header h1 {
    margin-bottom: 1.5rem;
  }

  .page-header > p:last-child {
    font-size: 1.2rem;
  }

  .projects-list {
    display: grid;
    gap: 1.5rem;
  }

  @media (max-width: 700px) {
    .projects-page {
      padding-block: 3rem;
    }
  }
</style>
