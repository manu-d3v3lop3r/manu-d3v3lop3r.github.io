---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { contact } from "../../../data/contact";
---

<BaseLayout
  title="Contacto | Portfolio"
  description="Contacto profesional de Software Developer."
  lang="es"
>
  <article class="contact-page">
    <header class="page-header">
      <p class="eyebrow">CONTACTO</p>

      <h1>Hablemos</h1>

      <p class="intro">
        Si quieres conocer más sobre mi experiencia, proyectos o perfil
        profesional, puedes ponerte en contacto conmigo.
      </p>
    </header>

    <div class="contact-content">
      <section class="contact-section">
        <h2>Contacto profesional</h2>

        <p>
          Puedes encontrarme en LinkedIn para contactar conmigo y conocer más
          sobre mi perfil profesional.
        </p>

        <div class="contact-links">
          <a
            class="contact-link contact-link-primary"
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>
              <strong>LinkedIn</strong>
              <small>Perfil profesional y contacto</small>
            </span>
            <span aria-hidden="true">↗</span>
          </a>

          <a
            class="contact-link"
            href={contact.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>
              <strong>GitHub</strong>
              <small>Proyectos y código público</small>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="contact-section">
        <h2>Sobre este portfolio</h2>

        <p>
          Este portfolio reúne proyectos profesionales, académicos y personales
          para mostrar experiencia práctica, formación y evolución técnica.
        </p>

        <p>
          Los proyectos profesionales que contienen información confidencial se
          presentan mediante casos de estudio sin publicar código fuente ni
          información interna.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .contact-page {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 4rem 6rem;
  }

  .page-header {
    max-width: 850px;
    margin-bottom: 5rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .page-header h1 {
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 750px;
    font-size: 1.25rem;
  }

  .contact-content {
    max-width: 800px;
  }

  .contact-section {
    padding-block: 3rem;
    border-top: 1px solid var(--color-border);
  }

  .contact-section:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .contact-section h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .contact-section p + p {
    margin-top: 1.25rem;
  }

  .contact-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .contact-link:hover {
    background: var(--color-surface-subtle);
    border-color: var(--color-primary);
  }

  .contact-link-primary {
    border-color: var(--color-primary);
  }

  .contact-link strong,
  .contact-link small {
    display: block;
  }

  .contact-link strong {
    margin-bottom: 0.25rem;
  }

  .contact-link small {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .contact-link > span:last-child {
    flex-shrink: 0;
    color: var(--color-primary);
    font-size: 1.25rem;
  }

  @media (max-width: 700px) {
    .contact-page {
      padding-block: 3rem 5rem;
    }

    .page-header {
      margin-bottom: 4rem;
    }

    .contact-section {
      padding-block: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
