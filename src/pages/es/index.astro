---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/sections/Hero.astro";
import WhatIDo from "../../components/sections/WhatIDo.astro";
import SelectedWork from "../../components/sections/SelectedWork.astro";
import ExperiencePreview from "../../components/sections/ExperiencePreview.astro";
import TechStack from "../../components/sections/TechStack.astro";
import AboutPreview from "../../components/sections/AboutPreview.astro";
import ContactCTA from "../../components/sections/ContactCTA.astro";
import { person } from "../../data/profile";

const lang = "es";
---

<BaseLayout
  title={`${person.name} | ${person.role[lang]}`}
  description={"Portfolio de Manuel Jiménez, desarrollador Full Stack en Madrid: APIs REST con Java y Spring Boot, aplicaciones web con PHP, MySQL y JavaScript y automatización de procesos."}
  lang={lang}
>
  <Hero lang={lang} />
  <SelectedWork lang={lang} />
  <WhatIDo lang={lang} />
  <ExperiencePreview lang={lang} />
  <TechStack lang={lang} />
  <AboutPreview lang={lang} />
  <ContactCTA lang={lang} />
</BaseLayout>
