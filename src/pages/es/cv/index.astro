---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="CV | Portfolio"
  description="Currículum profesional de Software Developer con experiencia en desarrollo web, sistemas y automatización."
  lang="es"
>
  <article class="cv-page">
    <header class="cv-header">
      <div>
        <p class="eyebrow">CURRÍCULUM</p>

        <h1>Software Developer</h1>

        <p class="intro">
          Perfil orientado al desarrollo de software, aplicaciones web, backend,
          automatización y entornos IT.
        </p>
      </div>

      <div class="cv-actions">
        <a class="button button-primary" href="#experiencia">
          Ver experiencia
        </a>

        <a class="button button-secondary" href="/es/contacto/"> Contactar </a>
      </div>
    </header>

    <div class="cv-content">
      <section id="experiencia" class="cv-section">
        <header class="section-header">
          <p class="section-label">EXPERIENCIA</p>
          <h2>Experiencia profesional</h2>
        </header>

        <div class="timeline">
          <article class="timeline-item">
            <div class="timeline-heading">
              <div>
                <h3>Técnico en Operaciones de Sistemas Informáticos</h3>
                <p>Empresa confidencial</p>
              </div>

              <span>≈ 1 año</span>
            </div>

            <ul>
              <li>
                Desarrollo y mantenimiento de aplicaciones web para
                digitalización y gestión documental.
              </li>
              <li>
                Trabajo con HTML, CSS, JavaScript, Bootstrap, jQuery,
                DataTables, PHP y MySQL.
              </li>
              <li>
                Configuración de entornos y servidores con Windows, Apache, PHP,
                MySQL y XAMPP.
              </li>
              <li>
                Configuración de IPs, puertos, usuarios, permisos y estructura
                de carpetas.
              </li>
              <li>
                Automatización de procesos mediante Microsoft Power Automate.
              </li>
              <li>
                Trabajo con Magnolia CMS en páginas, componentes, plantillas,
                contenidos, navegación y formularios.
              </li>
              <li>
                Mantenimiento, copias de seguridad, soporte a usuarios,
                instalación de software y configuración de equipos.
              </li>
            </ul>
          </article>

          <article class="timeline-item">
            <div class="timeline-heading">
              <div>
                <h3>Web Application Developer</h3>
                <p>Prácticas</p>
              </div>

              <span>3 meses</span>
            </div>

            <ul>
              <li>
                Participación en el desarrollo de una aplicación web para
                digitalización y gestión documental.
              </li>
              <li>
                Desarrollo con HTML, CSS, JavaScript, Bootstrap, jQuery y
                DataTables.
              </li>
              <li>Trabajo con PHP y MySQL.</li>
              <li>
                Uso de Google Apps Script y trabajo con el entorno local y
                servidor.
              </li>
            </ul>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">FORMACIÓN</p>
          <h2>Formación académica</h2>
        </header>

        <div class="education-list">
          <article class="education-item">
            <h3>Desarrollo de Aplicaciones Multiplataforma</h3>
            <p>Formación Profesional de Grado Superior · DAM</p>
          </article>

          <article class="education-item">
            <h3>Master Full Stack Development</h3>
            <p>MasterD · Formación especializada en desarrollo Full Stack</p>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">COMPETENCIAS</p>
          <h2>Áreas técnicas</h2>
        </header>

        <div class="skills-grid">
          <article>
            <h3>Desarrollo</h3>
            <p>Java · Kotlin · Python · JavaScript · PHP · HTML · CSS · XML</p>
          </article>

          <article>
            <h3>Web y backend</h3>
            <p>
              Spring Boot · Bootstrap · jQuery · DataTables · REST APIs · AJAX ·
              JSON
            </p>
          </article>

          <article>
            <h3>Bases de datos</h3>
            <p>SQL · MySQL · MySQL Workbench · Firebase</p>
          </article>

          <article>
            <h3>Automatización</h3>
            <p>Microsoft Power Automate · Google Apps Script</p>
          </article>

          <article>
            <h3>CMS y plataformas</h3>
            <p>Magnolia · WordPress · SharePoint · Joomla</p>
          </article>

          <article>
            <h3>Herramientas y sistemas</h3>
            <p>
              Git · GitHub · Postman · XAMPP · Apache · VirtualBox · PowerShell
            </p>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">PROYECTOS</p>
          <h2>Proyectos destacados</h2>
        </header>

        <div class="projects-list">
          <article>
            <h3>Gestión y digitalización documental</h3>
            <p>
              Proyecto profesional de desarrollo de una aplicación web para
              digitalización y gestión de documentación.
            </p>
            <a href="/es/proyectos/gestion-documental/"> Ver proyecto </a>
          </article>

          <article>
            <h3>Aplicación Android de turismo</h3>
            <p>
              Proyecto académico de una aplicación móvil para crear rutas
              turísticas personalizadas en Madrid.
            </p>
            <a href="/es/proyectos/turismo-android/"> Ver proyecto </a>
          </article>

          <article>
            <h3>Automatización de gestión de solicitudes</h3>
            <p>
              Automatización de un proceso interno mediante Microsoft Forms,
              Microsoft Lists y Power Automate.
            </p>
            <a href="/es/proyectos/power-automate/"> Ver proyecto </a>
          </article>

          <article>
            <h3>Rediseño y migración de portal institucional</h3>
            <p>
              Trabajo profesional con Magnolia CMS para reorganizar y migrar
              contenidos dentro de un nuevo portal institucional.
            </p>
            <a href="/es/proyectos/magnolia/"> Ver proyecto </a>
          </article>
        </div>
      </section>

      <section class="cv-section">
        <header class="section-header">
          <p class="section-label">APRENDIZAJE</p>
          <h2>Formación complementaria</h2>
        </header>

        <ul class="course-list">
          <li>Java y Programación Orientada a Objetos · Mouredev</li>
          <li>Python Essentials 1 · Cisco</li>
          <li>Python Essentials 2 · Cisco</li>
          <li>JavaScript Essentials 1 · Cisco</li>
          <li>Introducción al desarrollo web · Google</li>
          <li>Introducción al desarrollo de aplicaciones móviles · Google</li>
          <li>Excel</li>
          <li>Prompt Engineering</li>
          <li>Responsible AI & Prompt Engineering</li>
          <li>Ciberseguridad para el teletrabajo</li>
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .cv-page {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 4rem 6rem;
  }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-header > div:first-child {
    max-width: 800px;
  }

  .eyebrow,
  .section-label {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .cv-header h1 {
    margin-bottom: 1.5rem;
  }

  .intro {
    max-width: 700px;
    font-size: 1.2rem;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button-secondary:hover {
    background: var(--color-surface-subtle);
  }

  .cv-content {
    max-width: 1000px;
  }

  .cv-section {
    padding-block: 4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    margin: 0;
  }

  .timeline {
    display: grid;
    gap: 3rem;
  }

  .timeline-item {
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .timeline-heading h3 {
    margin-bottom: 0.4rem;
  }

  .timeline-heading p,
  .timeline-heading span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .timeline-heading span {
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .timeline-item ul {
    margin: 0;
    padding-left: 1.5rem;
  }

  .timeline-item li + li {
    margin-top: 0.6rem;
  }

  .education-list {
    display: grid;
    gap: 1rem;
  }

  .education-item {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .education-item h3 {
    margin-bottom: 0.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .skills-grid article {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .skills-grid h3 {
    margin-bottom: 0.75rem;
    font-size: 1.15rem;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .projects-list article {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .projects-list h3 {
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  .projects-list p {
    margin-bottom: 1rem;
  }

  .projects-list a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .projects-list a:hover {
    color: var(--color-primary-hover);
  }

  .course-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 2rem;
    margin: 0;
    padding-left: 1.25rem;
  }

  .course-list li {
    padding-block: 0.25rem;
  }

  @media (max-width: 800px) {
    .cv-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .skills-grid,
    .projects-list,
    .course-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .cv-page {
      padding-block: 3rem 5rem;
    }

    .cv-header {
      padding-bottom: 3rem;
    }

    .cv-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .cv-section {
      padding-block: 3rem;
    }

    .timeline-heading {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
