---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/typography.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import { localeRoutes } from "../data/locales";
import { contact } from "../data/contact";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

const { title, description, lang } = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = Astro.url.href;

const routeEntry = Object.values(localeRoutes).find(
  (route) => route.es === currentPath || route.en === currentPath,
);

const alternateSpanishPath = routeEntry?.es;
const alternateEnglishPath = routeEntry?.en;

const openGraphLocale = lang === "es" ? "es_ES" : "en_US";
const alternateOpenGraphLocale = lang === "es" ? "en_US" : "es_ES";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Software Developer Portfolio",
  url: Astro.url.origin,
  inLanguage: lang,
  about: {
    "@type": "Person",
    name: "Manuel Jiménez",
    jobTitle: "Software Developer",
    description:
      "Software Developer based in Madrid, Spain, with experience in web development, backend development, full stack development and automation.",
    url: Astro.url.origin,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Madrid",
      addressCountry: "ES",
    },
    knowsLanguage: ["es", "en"],
    knowsAbout: [
      "Software Development",
      "Web Development",
      "Backend Development",
      "Full Stack Development",
      "Automation",
      "Java",
      "Kotlin",
      "Python",
      "JavaScript",
      "PHP",
      "HTML",
      "CSS",
      "XML",
      "SQL",
      "Spring Boot",
      "Bootstrap",
      "jQuery",
      "DataTables",
      "REST APIs",
      "AJAX",
      "JSON",
      "Firebase",
      "Power Automate",
      "Google Apps Script",
      "Magnolia CMS",
      "WordPress",
      "SharePoint",
      "Joomla",
      "Git",
      "GitHub",
      "Postman",
      "XAMPP",
      "Apache",
      "VirtualBox",
      "MySQL",
    ],
    sameAs: [contact.github, contact.linkedin],
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      alternateSpanishPath && (
        <link
          rel="alternate"
          hreflang="es"
          href={`${Astro.url.origin}${alternateSpanishPath}`}
        />
      )
    }

    {
      alternateEnglishPath && (
        <link
          rel="alternate"
          hreflang="en"
          href={`${Astro.url.origin}${alternateEnglishPath}`}
        />
      )
    }

    {
      alternateSpanishPath && alternateEnglishPath && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${Astro.url.origin}${alternateSpanishPath}`}
        />
      )
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocale} />

    {
      alternateSpanishPath && alternateEnglishPath && (
        <meta
          property="og:locale:alternate"
          content={alternateOpenGraphLocale}
        />
      )
    }

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body>
    <Header lang={lang} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
