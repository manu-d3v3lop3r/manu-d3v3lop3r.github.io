---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/typography.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

import { contact } from "../data/contact";
import { person, knowsAbout } from "../data/profile";
import { getAlternates, type Lang } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  ogType = "website",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const alternates = getAlternates(Astro.url.pathname);

const openGraphLocale = lang === "es" ? "es_ES" : "en_US";
const alternateOpenGraphLocale = lang === "es" ? "en_US" : "es_ES";
const siteName = `${person.name} · ${person.role[lang]}`;
const ogImage = new URL("/og-image.jpg", site).href;
const ogImageAlt = `${person.name} — ${person.role[lang]}`;

const sameAs = [contact.github, contact.linkedin].filter(Boolean);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      name: siteName,
      url: site.origin,
      inLanguage: ["es", "en"],
      publisher: { "@id": `${site.origin}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${site.origin}/#person`,
      name: person.name,
      jobTitle: person.role[lang],
      image: ogImage,
      description: person.headline[lang],
      url: site.origin,
      address: {
        "@type": "PostalAddress",
        addressLocality: "Madrid",
        addressCountry: "ES",
      },
      knowsLanguage: ["es", "en"],
      knowsAbout,
      sameAs,
    },
  ],
};

const skipLabel = lang === "es" ? "Saltar al contenido" : "Skip to content";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        let theme;

        try {
          const stored = localStorage.getItem("portfolio-theme");
          if (stored === "light" || stored === "dark") theme = stored;
        } catch {
          /* Storage unavailable (private mode, blocked cookies…) */
        }

        theme ??= window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta name="generator" content={Astro.generator} />

    <meta
      name="theme-color"
      content="#fafaf9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f0f10"
      media="(prefers-color-scheme: dark)"
    />

    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      alternates && (
        <>
          <link
            rel="alternate"
            hreflang="es"
            href={new URL(alternates.es, site).href}
          />
          <link
            rel="alternate"
            hreflang="en"
            href={new URL(alternates.en, site).href}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(alternates.es, site).href}
          />
        </>
      )
    }

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocale} />
    {
      alternates && (
        <meta
          property="og:locale:alternate"
          content={alternateOpenGraphLocale}
        />
      )
    }

    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>

    <Header lang={lang} />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style>
  main:focus {
    outline: none;
    box-shadow: none;
  }
</style>
