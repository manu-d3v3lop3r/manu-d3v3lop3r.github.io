---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import { person } from "../data/profile";
import {
  projectHref,
  projectStatusLabels,
  projectTypeLabels,
  route,
  type Lang,
} from "../i18n/utils";
import { getProjects } from "../utils/projects";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
}

const { project, lang } = Astro.props;
const {
  title,
  summary,
  type,
  status,
  year,
  technologies,
  role,
  team,
  confidential,
  repository,
  demo,
} = project.data;

const linkLabels =
  lang === "es"
    ? { code: "Ver código en GitHub", demo: "Ver demo" }
    : { code: "View code on GitHub", demo: "View live demo" };

const projects = await getProjects(lang);
const index = projects.findIndex((entry) => entry.id === project.id);
const previous = index > 0 ? projects[index - 1] : undefined;
const next = index < projects.length - 1 ? projects[index + 1] : undefined;

const t =
  lang === "es"
    ? {
        back: "Todos los proyectos",
        breadcrumb: "Ruta de navegación",
        home: "Inicio",
        projects: "Proyectos",
        status: "Estado",
        year: "Año",
        role: "Mi rol",
        team: "Equipo",
        technologies: "Tecnologías",
        confidential:
          "Proyecto profesional confidencial: el código fuente y los datos internos no se publican. Este caso de estudio describe el problema, la solución y mi participación.",
        previous: "Proyecto anterior",
        next: "Siguiente proyecto",
        more: "Más proyectos",
      }
    : {
        back: "All projects",
        breadcrumb: "Breadcrumb",
        home: "Home",
        projects: "Projects",
        status: "Status",
        year: "Year",
        role: "My role",
        team: "Team",
        technologies: "Technologies",
        confidential:
          "Confidential professional project: source code and internal data are not published. This case study describes the problem, the solution and my contribution.",
        previous: "Previous project",
        next: "Next project",
        more: "More projects",
      };
---

<BaseLayout
  title={`${title} | ${person.name}`}
  description={summary}
  lang={lang}
  ogType="article"
>
  <article class="project container">
    <nav class="breadcrumb" aria-label={t.breadcrumb}>
      <ol>
        <li><a href={route("home", lang)}>{t.home}</a></li>
        <li><a href={route("projects", lang)}>{t.projects}</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <header class="project-header">
      <p class="eyebrow">{projectTypeLabels[type][lang]}</p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>

      <dl class="project-meta">
        <div class="meta-role">
          <dt>{t.role}</dt>
          <dd>{role}</dd>
        </div>
        {
          team && (
            <div>
              <dt>{t.team}</dt>
              <dd>{team}</dd>
            </div>
          )
        }
        <div>
          <dt>{t.status}</dt>
          <dd>{projectStatusLabels[status][lang]}</dd>
        </div>
        {
          year && (
            <div>
              <dt>{t.year}</dt>
              <dd>{year}</dd>
            </div>
          )
        }
      </dl>

      <div class="technologies">
        <h2 class="visually-hidden">{t.technologies}</h2>
        <ul class="tag-list">
          {technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      </div>

      {
        (repository || demo) && (
          <div class="button-group project-links">
            {repository && (
              <a
                class="button button-primary"
                href={repository}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  aria-hidden="true"
                  fill="currentColor"
                >
                  <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
                </svg>
                {linkLabels.code}
              </a>
            )}
            {demo && (
              <a
                class="button button-secondary"
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
              >
                {linkLabels.demo} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )
      }

      {
        confidential && (
          <p class="confidential" role="note">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="4" y="11" width="16" height="10" rx="2" />
              <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            <span>{t.confidential}</span>
          </p>
        )
      }
    </header>

    <div class="project-content">
      <slot />
    </div>

    {
      (previous || next) && (
        <nav class="pager" aria-label={t.more}>
          {previous ? (
            <a class="pager-link" href={projectHref(lang, previous.data)}>
              <span class="meta">← {t.previous}</span>
              <span class="pager-title">{previous.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="pager-link pager-next" href={projectHref(lang, next.data)}>
              <span class="meta">{t.next} →</span>
              <span class="pager-title">{next.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>

  <ContactCTA lang={lang} />
</BaseLayout>

<style>
  .project {
    padding-block: 2rem 2rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: 0.4rem;
    color: var(--color-border-strong);
  }

  .breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .breadcrumb [aria-current] {
    color: var(--color-text);
  }

  .project-header {
    max-width: 880px;
    margin-bottom: 3.5rem;
  }

  .project-header h1 {
    margin-bottom: 1.5rem;
  }

  .project-meta {
    display: grid;
    grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0 1.75rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-border);
  }

  .project-meta div {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .project-meta dt {
    color: var(--color-text-muted);
    font-size: 0.825rem;
  }

  .project-meta dd {
    margin: 0;
    font-size: 0.95rem;
  }

  .confidential {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: none;
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .confidential svg {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-primary);
  }

  /* Markdown content ------------------------------------------------------ */

  .project-content {
    max-width: 760px;
  }

  .project-content :global(h2) {
    margin-top: 3.5rem;
    margin-bottom: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
  }

  .project-content :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .project-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: 1.2rem;
  }

  .project-content :global(p),
  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: 1.1rem;
    color: var(--color-text-secondary);
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.4rem;
  }

  .project-content :global(li + li) {
    margin-top: 0.35rem;
  }

  .project-content :global(strong) {
    color: var(--color-text);
  }

  .project-content :global(code) {
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    color: var(--color-text);
    font-size: 0.875em;
  }

  .project-content :global(img) {
    width: 100%;
    height: auto;
    margin-block: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
  }

  .project-links {
    margin-top: 1.75rem;
  }

  /* Pager ----------------------------------------------------------------- */

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 880px;
    margin-top: 4rem;
  }

  .pager-link {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
  }

  .pager-link:hover {
    border-color: var(--color-primary);
  }

  .pager-next {
    grid-column: 2;
    text-align: right;
  }

  .pager-title {
    color: var(--color-text);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .project-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta-role {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .project-meta {
      grid-template-columns: 1fr;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager-next {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
