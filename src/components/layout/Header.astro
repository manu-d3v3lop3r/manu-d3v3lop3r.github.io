---
import { navigation } from "../../data/navigation";
import { person } from "../../data/profile";
import type { Lang } from "../../i18n/utils";
import LanguageSwitcher from "../navigation/LanguageSwitcher.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const links = navigation[lang];

const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const homeHref = `/${lang}/`;

/** Home is only active on its exact URL; other sections also match their sub-pages. */
const isActive = (href: string) =>
  href === homeHref ? currentPath === href : currentPath.startsWith(href);

const labels =
  lang === "es"
    ? {
        open: "Abrir menú",
        close: "Cerrar menú",
        theme: "Cambiar entre tema claro y oscuro",
        nav: "Navegación principal",
        home: "Inicio",
      }
    : {
        open: "Open menu",
        close: "Close menu",
        theme: "Toggle light and dark theme",
        nav: "Main navigation",
        home: "Home",
      };
---

<header class="site-header">
  <div class="header-inner container">
    <a class="site-brand" href={homeHref} aria-label={`${person.name} — ${labels.home}`}>
      <span class="brand-mark" aria-hidden="true">MJ</span>
      <span class="brand-text">
        <span class="brand-name">{person.name}</span>
        <span class="brand-role">{person.role[lang]}</span>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label={labels.open}
      data-label-open={labels.open}
      data-label-close={labels.close}
    >
      <span class="menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="header-actions" id="main-navigation">
      <nav aria-label={labels.nav}>
        <ul class="navigation-list">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-tools">
        <LanguageSwitcher lang={lang} />

        <button
          class="theme-toggle"
          type="button"
          aria-label={labels.theme}
          aria-pressed="false"
          data-theme-toggle
        >
          <svg
            class="theme-icon theme-icon-light"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path>
          </svg>
          <svg
            class="theme-icon theme-icon-dark"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const MOBILE_QUERY = "(max-width: 1100px)";

  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle");
    const panel = header.querySelector<HTMLElement>(".header-actions");
    const themeToggle = header.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]",
    );

    if (!toggle || !panel) return;

    const openLabel = toggle.dataset.labelOpen ?? "Open menu";
    const closeLabel = toggle.dataset.labelClose ?? "Close menu";

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const setMenuState = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
      panel.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
    };

    toggle.addEventListener("click", () => setMenuState(!isOpen()));

    panel.addEventListener("click", (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest("a") &&
        window.matchMedia(MOBILE_QUERY).matches
      ) {
        setMenuState(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        setMenuState(false);
        toggle.focus();
      }
    });

    window.matchMedia(MOBILE_QUERY).addEventListener("change", (query) => {
      if (!query.matches) setMenuState(false);
    });

    if (themeToggle) {
      const root = document.documentElement;

      const syncThemeButton = () =>
        themeToggle.setAttribute(
          "aria-pressed",
          String(root.dataset.theme === "dark"),
        );

      syncThemeButton();

      themeToggle.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";

        root.dataset.theme = nextTheme;
        root.style.colorScheme = nextTheme;

        try {
          localStorage.setItem("portfolio-theme", nextTheme);
        } catch {
          /* Storage unavailable: the theme still applies for this page view. */
        }

        syncThemeButton();
      });
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    /* Keeps the header still while the page content transitions. */
    view-transition-name: site-header;
  }

  .header-inner {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-text {
    display: grid;
    line-height: 1.2;
  }

  .brand-name {
    font-weight: 700;
  }

  .brand-role {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .navigation-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation-list a {
    display: inline-block;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: 0.925rem;
    text-decoration: none;
  }

  .navigation-list a:hover {
    background: var(--color-surface-subtle);
    color: var(--color-text);
  }

  .navigation-list a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
    background: var(--color-surface-subtle);
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-toggle,
  .menu-toggle {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .menu-toggle:hover {
    background: var(--color-surface-subtle);
  }

  .theme-icon-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-light {
    display: none;
  }

  :global(html[data-theme="dark"]) .theme-icon-dark {
    display: block;
  }

  .menu-toggle {
    display: none;
  }

  .menu-icon {
    display: grid;
    gap: 0.3rem;
  }

  .menu-icon span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    border-radius: var(--radius-pill);
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(1) {
    transform: translateY(0.4rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon span:nth-child(3) {
    transform: translateY(-0.4rem) rotate(-45deg);
  }

  @media (max-width: 1240px) {
    .brand-role {
      display: none;
    }
  }

  @media (max-width: 1100px) {
    .brand-role {
      display: block;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .header-actions {
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      max-height: calc(100dvh - 4.5rem);
      overflow-y: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1rem 1.5rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-background);
    }

    .header-actions.is-open {
      display: flex;
    }

    .navigation-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .navigation-list li {
      border-bottom: 1px solid var(--color-border);
    }

    .navigation-list a {
      display: block;
      padding: 0.9rem 0.25rem;
      border-radius: 0;
      font-size: 1rem;
    }

    .navigation-list a[aria-current="page"] {
      background: transparent;
      color: var(--color-primary);
    }

    .header-tools {
      justify-content: space-between;
    }
  }
</style>
