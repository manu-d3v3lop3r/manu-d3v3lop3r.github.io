---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const footerText =
  lang === "es"
    ? "Software Developer · Madrid, España"
    : "Software Developer · Madrid, Spain";

const copyright =
  lang === "es" ? "Todos los derechos reservados." : "All rights reserved.";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <p class="footer-name">Software Developer</p>
      <p class="footer-location">{footerText}</p>
    </div>

    <p class="copyright">
      © {new Date().getFullYear()} · {copyright}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 2rem;
    display: grid;
    gap: 1rem;
  }

  .footer-name {
    color: var(--color-text);
    font-weight: 700;
  }

  .footer-location,
  .copyright {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
