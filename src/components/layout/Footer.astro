---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const footerRole =
  lang === "es"
    ? "Software Developer · Madrid, España"
    : "Software Developer · Madrid, Spain";

const footerDescription =
  lang === "es" ? "Portfolio profesional" : "Professional portfolio";

const copyright =
  lang === "es" ? "Todos los derechos reservados." : "All rights reserved.";
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <p class="footer-name">Software Developer</p>

      <p class="footer-role">{footerRole}</p>

      <p class="footer-description">{footerDescription}</p>
    </div>

    <p class="copyright">
      © {new Date().getFullYear()} · {copyright}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 2rem;
    display: grid;
    gap: 1rem;
  }

  .footer-identity {
    display: grid;
    gap: 0.25rem;
  }

  .footer-name {
    color: var(--color-text);
    font-weight: 700;
  }

  .footer-role,
  .footer-description,
  .copyright {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-description,
  .copyright {
    margin: 0;
  }

  @media (min-width: 700px) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 2rem;
    }

    .copyright {
      text-align: right;
    }
  }
</style>
