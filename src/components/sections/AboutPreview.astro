---
import { route, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        eyebrow: "Sobre mí",
        title: "Primero entender el problema; después, construir la solución.",
        paragraphs: [
          "Me formé como Técnico Superior en Desarrollo de Aplicaciones Multiplataforma y completé un máster en Full Stack Development.",
          "En mis dos experiencias profesionales he trabajado en organismos públicos donde el software tenía que encajar en procesos reales: digitalizar documentación en papel, automatizar comunicaciones internas o migrar un portal con muchos contenidos.",
          "Busco seguir creciendo como desarrollador web y backend en un equipo donde pueda aportar, aprender buenas prácticas y construir software claro y mantenible.",
        ],
        link: "Conocer mi perfil",
      }
    : {
        eyebrow: "About me",
        title: "Understand the problem first; then build the solution.",
        paragraphs: [
          "I trained as a Higher Technician in Multiplatform Application Development and completed a master's in Full Stack Development.",
          "In both of my professional roles I worked in public organisations where software had to fit real processes: digitising paper documentation, automating internal communications or migrating a content-heavy portal.",
          "I am looking to keep growing as a web and backend developer in a team where I can contribute, learn good practices and build clear, maintainable software.",
        ],
        link: "Read my profile",
      };
---

<section class="section container" aria-labelledby="about-preview-title">
  <div class="about-content">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="about-preview-title">{t.title}</h2>
    </div>

    <div class="about-text">
      {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

      <a class="text-link" href={route("about", lang)}>
        {t.link} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .about-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 4rem;
    padding-block: 4rem;
    border-block: 1px solid var(--color-border);
  }

  .about-text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .about-text p {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
  }

  @media (max-width: 800px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 3rem;
    }
  }
</style>
