---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const content =
  lang === "es"
    ? {
        eyebrow: "EXPERIENCIA TÉCNICA",
        title: "Áreas de experiencia",
        description:
          "Mi experiencia combina desarrollo de software con una visión práctica de los sistemas y procesos que hay detrás de una solución.",
        items: [
          {
            title: "Desarrollo de software",
            description:
              "Construyo aplicaciones y soluciones orientadas a necesidades concretas, trabajando desde la comprensión del problema hasta la implementación y puesta en funcionamiento.",
          },
          {
            title: "Desarrollo web y backend",
            description:
              "He trabajado en aplicaciones web conectando interfaces, lógica de aplicación, bases de datos y APIs para convertir procesos y necesidades en herramientas utilizables.",
          },
          {
            title: "Automatización de procesos",
            description:
              "Identifico tareas y procesos que pueden simplificarse y trabajo en su automatización para reducir trabajo manual y hacer los flujos más controlables.",
          },
          {
            title: "Sistemas y entornos tecnológicos",
            description:
              "Mi experiencia con servidores, configuraciones, permisos, conexiones y soporte me permite entender el software dentro del entorno en el que realmente tiene que funcionar.",
          },
        ],
      }
    : {
        eyebrow: "TECHNICAL EXPERIENCE",
        title: "Areas of Experience",
        description:
          "My experience combines software development with a practical understanding of the systems and processes behind a solution.",
        items: [
          {
            title: "Software Development",
            description:
              "I build applications and software solutions around concrete needs, from understanding the problem through implementation and deployment.",
          },
          {
            title: "Web & Backend Development",
            description:
              "I have worked on web applications connecting interfaces, application logic, databases and APIs to turn processes and needs into usable tools.",
          },
          {
            title: "Process Automation",
            description:
              "I identify tasks and processes that can be simplified and work on automating them to reduce manual work and make workflows more manageable.",
          },
          {
            title: "Systems & Technology Environments",
            description:
              "My experience with servers, configurations, permissions, connections and technical support helps me understand software within the environment where it actually needs to work.",
          },
        ],
      };
---

<section class="what-i-do" aria-labelledby="what-i-do-title">
  <div class="section-header">
    <p class="eyebrow">{content.eyebrow}</p>

    <h2 id="what-i-do-title">{content.title}</h2>

    <p>{content.description}</p>
  </div>

  <div class="areas-grid">
    {
      content.items.map((item) => (
        <article class="area-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .what-i-do {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 5rem;
  }

  .section-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .section-header h2 {
    margin-bottom: 1.25rem;
  }

  .section-header > p:last-child {
    font-size: 1.1rem;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .area-card {
    min-height: 220px;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .area-card h3 {
    margin-bottom: 1rem;
  }

  .area-card p {
    max-width: 55ch;
  }

  @media (max-width: 700px) {
    .what-i-do {
      padding-block: 4rem;
    }

    .areas-grid {
      grid-template-columns: 1fr;
    }

    .area-card {
      min-height: auto;
      padding: 1.5rem;
    }
  }
</style>
