---
import type { Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content =
  lang === "es"
    ? {
        eyebrow: "Qué aporto",
        title: "Áreas en las que puedo aportar",
        description:
          "Combino desarrollo de software con una visión práctica de los procesos y sistemas en los que ese software tiene que funcionar.",
        items: [
          {
            icon: "api",
            title: "Backend y APIs REST",
            description:
              "APIs con Java y Spring Boot: arquitectura por capas, seguridad con Spring Security y JWT, persistencia con JPA, documentación OpenAPI y tests con JUnit y Mockito.",
          },
          {
            icon: "web",
            title: "Aplicaciones web",
            description:
              "Aplicaciones completas con PHP, MySQL y JavaScript: modelo de datos, lógica de servidor, interfaces con Bootstrap y jQuery, configuración del servidor y puesta en producción.",
          },
          {
            icon: "automation",
            title: "Automatización de procesos",
            description:
              "Flujos con Power Automate, Microsoft Forms/Lists y Google Apps Script para eliminar tareas manuales repetitivas.",
          },
          {
            icon: "mobile",
            title: "Aplicaciones Android",
            description:
              "Apps nativas en Kotlin con Firebase (autenticación y datos) e integración de APIs externas como Google Maps.",
          },
        ],
      }
    : {
        eyebrow: "What I bring",
        title: "Where I can contribute",
        description:
          "I combine software development with a practical understanding of the processes and systems that software has to work within.",
        items: [
          {
            icon: "api",
            title: "Backend & REST APIs",
            description:
              "APIs with Java and Spring Boot: layered architecture, Spring Security with JWT, JPA persistence, OpenAPI documentation and tests with JUnit and Mockito.",
          },
          {
            icon: "web",
            title: "Web applications",
            description:
              "Complete applications with PHP, MySQL and JavaScript: data model, server logic, Bootstrap and jQuery interfaces, server setup and production rollout.",
          },
          {
            icon: "automation",
            title: "Process automation",
            description:
              "Workflows with Power Automate, Microsoft Forms/Lists and Google Apps Script to remove repetitive manual tasks.",
          },
          {
            icon: "mobile",
            title: "Android applications",
            description:
              "Native Kotlin apps with Firebase (authentication and data) and external API integration such as Google Maps.",
          },
        ],
      };

const icons: Record<string, string> = {
  api: "M8 9l-4 3 4 3M16 9l4 3-4 3M13.5 6l-3 12",
  web: "M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01",
  automation: "M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4",
  mobile: "M7 2h10v20H7zM11 18h2",
  systems: "M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01",
};
---

<section class="section container" aria-labelledby="what-i-do-title">
  <header class="section-header">
    <p class="eyebrow">{content.eyebrow}</p>
    <h2 id="what-i-do-title">{content.title}</h2>
    <p>{content.description}</p>
  </header>

  <div class="card-grid">
    {
      content.items.map((item) => (
        <article class="card area-card">
          <span class="area-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={icons[item.icon]} />
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .area-icon {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1.25rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .area-card h3 {
    margin-bottom: 0.75rem;
  }

  .area-card p {
    color: var(--color-text-secondary);
  }
</style>
