---
import { skills, skillLabel } from "../../data/profile";
import type { Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        eyebrow: "Stack técnico",
        title: "Tecnologías y herramientas",
        description:
          "Tecnologías con las que he trabajado en experiencia profesional, formación y proyectos.",
      }
    : {
        eyebrow: "Tech stack",
        title: "Technologies & tools",
        description:
          "Technologies I have worked with across professional experience, training and projects.",
      };
---

<section class="section container" aria-labelledby="tech-stack-title">
  <header class="section-header">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="tech-stack-title">{t.title}</h2>
    <p>{t.description}</p>
  </header>

  <div class="categories">
    {
      skills.map((group) => (
        <div class="category">
          <h3>{group.title[lang]}</h3>
          <ul class="tag-list">
            {group.items.map((item) => (
              <li>{skillLabel(item, lang)}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .category {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .category h3 {
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  @media (max-width: 960px) {
    .categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .categories {
      grid-template-columns: 1fr;
    }
  }
</style>
