---
import { experience } from "../../data/profile";
import { route, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        eyebrow: "Experiencia",
        title: "Trayectoria profesional",
        description:
          "Experiencia en el sector público desarrollando aplicaciones, automatizando procesos y modernizando plataformas web.",
        link: "Ver experiencia completa",
      }
    : {
        eyebrow: "Experience",
        title: "Professional background",
        description:
          "Public-sector experience building applications, automating processes and modernising web platforms.",
        link: "View full experience",
      };
---

<section class="section container" aria-labelledby="experience-title">
  <header class="section-header">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="experience-title">{t.title}</h2>
    <p>{t.description}</p>
  </header>

  <ol class="experience-list">
    {
      experience.map((job) => (
        <li class="experience-item">
          <div class="experience-meta">
            <p class="meta">{job.period[lang]}</p>
            <p class="meta">{job.duration[lang]}</p>
          </div>

          <div>
            <h3>{job.role[lang]}</h3>
            <p class="company">
              {job.company} · <span>{job.contractType[lang]}</span>
            </p>
            <p class="summary">{job.summary[lang]}</p>
            <ul class="tag-list">
              {job.technologies.slice(0, 6).map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="section-action">
    <a class="text-link" href={route("experience", lang)}>
      {t.link} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-item h3 {
    margin-bottom: 0.35rem;
  }

  .company {
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .company span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .summary {
    margin-bottom: 1.25rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 700px) {
    .experience-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
