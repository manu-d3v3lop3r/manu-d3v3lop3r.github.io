---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const content =
  lang === "es"
    ? {
        eyebrow: "EXPERIENCIA PROFESIONAL",
        title: "Experiencia profesional",
        description:
          "Experiencia profesional vinculada a la modernización de procesos internos, la automatización, la evolución de plataformas web y el soporte de entornos tecnológicos.",
        first: {
          role: "Técnico en Operaciones de Sistemas Informáticos",
          company: "UNED Madrid",
          duration: "≈ 1 año",
          description:
            "Participación en la modernización digital de procesos internos mediante automatización, mejora de plataformas web, documentación técnica, evaluación de soluciones tecnológicas y soporte de sistemas.",
        },
        second: {
          role: "Web Application Developer",
          company: "ESMASA (Prácticas)",
          duration: "3 meses",
          description:
            "Desarrollo de una aplicación web orientada a la digitalización y gestión documental, trabajando con tecnologías web, PHP, MySQL y Google Apps Script.",
        },
        link: "Ver trayectoria profesional",
      }
    : {
        eyebrow: "PROFESSIONAL EXPERIENCE",
        title: "Professional Experience",
        description:
          "Professional experience focused on internal process modernization, automation, web platform improvement and technical support.",
        first: {
          role: "IT Systems Operations Technician",
          company: "UNED Madrid",
          duration: "≈ 1 year",
          description:
            "Contributed to the digital modernization of internal processes through automation, web platform improvement, technical documentation, technology evaluation and systems support.",
        },
        second: {
          role: "Web Application Developer",
          company: "ESMASA (Internship)",
          duration: "3 months",
          description:
            "Development of a web application focused on document digitization and management, working with web technologies, PHP, MySQL and Google Apps Script.",
        },
        link: "View professional experience",
      };
---

<section class="experience-preview" aria-labelledby="experience-title">
  <header class="section-header">
    <p class="eyebrow">{content.eyebrow}</p>

    <h2 id="experience-title">{content.title}</h2>

    <p>{content.description}</p>
  </header>

  <div class="experience-list">
    <article class="experience-item">
      <div class="experience-heading">
        <div>
          <h3>{content.first.role}</h3>
          <p class="company">{content.first.company}</p>
        </div>

        <p class="duration">{content.first.duration}</p>
      </div>

      <p>{content.first.description}</p>
    </article>

    <article class="experience-item">
      <div class="experience-heading">
        <div>
          <h3>{content.second.role}</h3>
          <p class="company">{content.second.company}</p>
        </div>

        <p class="duration">{content.second.duration}</p>
      </div>

      <p>{content.second.description}</p>
    </article>
  </div>

  <div class="section-action">
    <a href={lang === "es" ? "/es/experiencia/" : "/en/experience/"}>
      {content.link}
    </a>
  </div>
</section>

<style>
  .experience-preview {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 5rem;
  }

  .section-header {
    max-width: 800px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .section-header h2 {
    margin-bottom: 1.25rem;
  }

  .section-header > p:last-child {
    font-size: 1.1rem;
  }

  .experience-list {
    border-top: 1px solid var(--color-border);
  }

  .experience-item {
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .experience-item h3 {
    margin-bottom: 0.4rem;
  }

  .company,
  .duration {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .duration {
    flex-shrink: 0;
    font-family: var(--font-mono);
  }

  .experience-item > p:last-child {
    max-width: 70ch;
  }

  .section-action {
    margin-top: 2rem;
  }

  .section-action a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .section-action a:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 650px) {
    .experience-preview {
      padding-block: 4rem;
    }

    .experience-heading {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
