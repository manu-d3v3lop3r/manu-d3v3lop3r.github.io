---
interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const content =
  lang === "es"
    ? {
        eyebrow: "SOFTWARE DEVELOPER",
        title: "Desarrollo software, aplicaciones web y automatizaciones.",
        description:
          "Experiencia en desarrollo, sistemas y proyectos tecnológicos, con interés en crear soluciones claras, mantenibles y útiles.",
        areas: ["Software Development", "Web", "Backend", "Automation"],
        location: "Madrid · España",
        projects: "Ver proyectos",
        cv: "Ver CV",
      }
    : {
        eyebrow: "SOFTWARE DEVELOPER",
        title: "Software development, web applications and automation.",
        description:
          "Experience in development, systems and technology projects, with a focus on creating clear, maintainable and useful solutions.",
        areas: ["Software Development", "Web", "Backend", "Automation"],
        location: "Madrid · Spain",
        projects: "View projects",
        cv: "View CV",
      };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-content">
    <p class="hero-eyebrow">{content.eyebrow}</p>

    <h1 id="hero-title">{content.title}</h1>

    <p class="hero-description">
      {content.description}
    </p>

    <ul class="hero-areas" aria-label={lang === "es" ? "Áreas" : "Areas"}>
      {content.areas.map((area) => <li>{area}</li>)}
    </ul>

    <p class="hero-location">{content.location}</p>

    <div class="hero-actions">
      <a
        class="button button-primary"
        href={lang === "es" ? "/es/proyectos/" : "/en/projects/"}
      >
        {content.projects}
      </a>

      <a
        class="button button-secondary"
        href={lang === "es" ? "/es/cv/" : "/en/cv/"}
      >
        {content.cv}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
    padding-block: 6rem 7rem;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-eyebrow {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .hero h1 {
    max-width: 900px;
    margin-bottom: 2rem;
  }

  .hero-description {
    max-width: 700px;
    margin-bottom: 2rem;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
  }

  .hero-areas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .hero-areas li {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .hero-location {
    margin-bottom: 2rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
  }

  .button-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .button-primary:hover {
    background: var(--color-primary-hover);
  }

  .button-secondary {
    border-color: var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button-secondary:hover {
    background: var(--color-surface-subtle);
  }

  @media (max-width: 700px) {
    .hero {
      padding-block: 4rem 5rem;
    }

    .hero h1 {
      margin-bottom: 1.5rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      width: 100%;
    }
  }
</style>
