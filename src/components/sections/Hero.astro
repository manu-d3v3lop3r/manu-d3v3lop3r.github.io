---
import { Picture } from "astro:assets";
// Background removed with scripts/photo-cutout.mjs so the photo adapts to the theme.
import profilePhoto from "../../assets/manuel-jimenez-cutout.png";
import { contact } from "../../data/contact";
import { cvPdf, person } from "../../data/profile";
import { route, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        title: "Convierto procesos y necesidades reales en software que funciona.",
        description:
          "Desarrollador Full Stack formado en DAM y en un máster de Full Stack. Construyo APIs REST con Java y Spring Boot, he llevado a producción una aplicación web de gestión documental con PHP y MySQL, y he automatizado procesos en una universidad pública.",
        projects: "Ver proyectos",
        cv: "Ver CV",
        facts: [
          { value: "+1 año", label: "de experiencia profesional en el sector público" },
          { value: "56 tests", label: "en mi API REST con Spring Boot (84 % de cobertura)" },
          { value: "De 0 a producción", label: "una aplicación web de gestión documental con PHP y MySQL" },
        ],
        factsLabel: "Datos destacados",
        areasLabel: "Áreas principales",
        downloadCv: "Descargar CV (PDF)",
      }
    : {
        title: "I turn real processes and needs into software that works.",
        description:
          "Full Stack Developer trained in Multiplatform Application Development and a Full Stack master's. I build REST APIs with Java and Spring Boot, I took a PHP and MySQL document management web app to production, and I have automated processes at a public university.",
        projects: "View projects",
        cv: "View CV",
        facts: [
          { value: "1+ year", label: "of professional experience in the public sector" },
          { value: "56 tests", label: "in my Spring Boot REST API (84% line coverage)" },
          { value: "From 0 to production", label: "a PHP and MySQL document management web app" },
        ],
        factsLabel: "Highlights",
        areasLabel: "Main areas",
        downloadCv: "Download CV (PDF)",
      };

const areas = [
  "Java · Spring Boot",
  lang === "es" ? "APIs REST" : "REST APIs",
  "PHP · MySQL",
  "JavaScript",
  "JUnit · Mockito",
  "Git · GitHub",
  "Power Automate",
];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-main">
    <figure class="hero-photo">
      <Picture
        src={profilePhoto}
        alt={lang === "es"
          ? `Fotografía de ${person.name}`
          : `Photo of ${person.name}`}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[240, 420, 640, 840]}
        sizes="(max-width: 860px) 7.5rem, 26rem"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <div class="hero-content">
      <p class="availability">
        <span class="availability-dot" aria-hidden="true"></span>
        {person.availability[lang]}
      </p>

      <p class="eyebrow">{person.name} · {person.role[lang]}</p>

      <h1 id="hero-title">{t.title}</h1>

      <p class="hero-description lead">{t.description}</p>

      <ul class="tag-list hero-areas" aria-label={t.areasLabel}>
        {areas.map((area) => <li>{area}</li>)}
      </ul>

      <div class="button-group">
        <a class="button button-primary" href={route("projects", lang)}>
          {t.projects}
          <span aria-hidden="true">→</span>
        </a>

        <a class="button button-secondary" href={route("cv", lang)}>
          {t.cv}
        </a>

        <a
          class="button button-secondary"
          href={contact.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="hero-location">
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"
          ></path>
          <circle cx="12" cy="9.5" r="2.5"></circle>
        </svg>
        {person.location[lang]}
        <span class="hero-meta-sep" aria-hidden="true">·</span>
        <a class="text-link" href={cvPdf[lang]} download>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 21h14"></path>
          </svg>
          {t.downloadCv}
        </a>
      </p>
    </div>
  </div>

  <dl class="hero-facts" aria-label={t.factsLabel}>
    {
      t.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: 5.5rem 4rem;
  }

  /* Decorative full-bleed backdrop: dotted grid + soft brand glow (pure CSS). */
  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    inset: 0 calc(50% - 50vw);
    background-image: radial-gradient(
      circle,
      var(--color-border-strong) 1px,
      transparent 1.5px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(
      ellipse 70% 65% at 70% 30%,
      #000 10%,
      transparent 75%
    );
    opacity: 0.7;
  }

  .hero::after {
    top: -12rem;
    right: -10rem;
    width: 42rem;
    height: 42rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-primary-soft),
      transparent 65%
    );
    filter: blur(20px);
  }

  /* Staggered entrance on first paint (skipped with reduced motion). */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .hero-content > *,
    .hero-photo,
    .hero-facts {
      animation: hero-in 700ms cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }

    .hero-content > :nth-child(2) { animation-delay: 60ms; }
    .hero-content > :nth-child(3) { animation-delay: 120ms; }
    .hero-content > :nth-child(4) { animation-delay: 180ms; }
    .hero-content > :nth-child(n + 5) { animation-delay: 240ms; }
    .hero-photo { animation-delay: 150ms; }
    .hero-facts { animation-delay: 320ms; }
  }

  .hero h1 {
    background: linear-gradient(
      100deg,
      var(--color-text) 55%,
      var(--color-primary) 130%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (forced-colors: active) {
    .hero h1 {
      background: none;
      -webkit-text-fill-color: currentColor;
    }
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem);
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    grid-row: 1;
    max-width: 760px;
  }

  .hero-photo {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    /* Transparent cutout over a theme-aware backdrop (brand glow + subtle grid). */
    background:
      radial-gradient(
        circle at 50% 38%,
        var(--color-primary-soft),
        transparent 62%
      ),
      linear-gradient(
        180deg,
        var(--color-surface-subtle),
        var(--color-surface) 70%
      );
    box-shadow: 0 30px 60px -35px rgba(0, 0, 0, 0.45);
  }

  .hero-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(circle at 50% 35%, #000, transparent 70%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-photo :global(picture) {
    position: relative;
    display: block;
    height: 100%;
  }

  .hero-photo::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 4px;
    background: var(--color-primary);
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }

  @media (max-width: 860px) {
    .hero-main {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero-photo {
      grid-column: 1;
      width: 7.5rem;
      aspect-ratio: 1;
      border-radius: 50%;
      box-shadow: none;
    }

    .hero-photo::after {
      display: none;
    }

    .hero-photo :global(img) {
      object-position: 50% 12%;
      transform: scale(1.6);
      transform-origin: 50% 18%;
    }

    .hero-content {
      grid-row: 2;
    }
  }

  .hero h1 {
    margin-bottom: 1.75rem;
  }

  .hero-description {
    margin-bottom: 2rem;
  }

  .hero-areas {
    margin-bottom: 2rem;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem 0.85rem 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .availability-dot {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: #16a34a;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .availability-dot::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #16a34a;
      animation: availability-pulse 2.4s ease-out infinite;
    }
  }

  @keyframes availability-pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  .hero-meta-sep {
    color: var(--color-border-strong);
  }

  .hero-location .text-link {
    font-size: 0.925rem;
  }

  .hero-location {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.75rem;
    color: var(--color-text-muted);
    font-size: 0.925rem;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 4.5rem 0 0;
    border-block: 1px solid var(--color-border);
  }

  .hero-facts div {
    display: flex;
    flex-direction: column-reverse;
    /* In column-reverse, flex-end aligns to the top: values line up across columns. */
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
  }

  .hero-facts div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }

  .hero-facts dt {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .hero-facts dd {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  @media (max-width: 700px) {
    .hero {
      padding-block: 3.5rem 2rem;
    }

    .hero-facts {
      grid-template-columns: 1fr;
      margin-top: 3rem;
    }

    .hero-facts div,
    .hero-facts div + div {
      padding: 1.1rem 0;
      border-left: 0;
    }

    .hero-facts div + div {
      border-top: 1px solid var(--color-border);
    }
  }
</style>
