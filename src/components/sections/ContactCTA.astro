---
import { contact } from "../../data/contact";
import { route, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const t =
  lang === "es"
    ? {
        eyebrow: "Contacto",
        title: "¿Buscas un desarrollador para tu equipo?",
        description:
          "Estoy abierto a nuevas oportunidades como desarrollador web, backend o full stack. La forma más rápida de contactar conmigo es LinkedIn.",
        primary: "Escribirme por LinkedIn",
        secondary: "Ver CV",
      }
    : {
        eyebrow: "Contact",
        title: "Looking for a developer for your team?",
        description:
          "I am open to new opportunities as a web, backend or full stack developer. The quickest way to reach me is LinkedIn.",
        primary: "Message me on LinkedIn",
        secondary: "View CV",
      };
---

<section class="section container" aria-labelledby="contact-cta-title">
  <div class="cta-content">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="contact-cta-title">{t.title}</h2>
    <p class="cta-description">{t.description}</p>

    <div class="button-group">
      <a
        class="button button-primary"
        href={contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.primary} <span aria-hidden="true">↗</span>
      </a>

      {
        contact.email && (
          <a class="button button-secondary" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        )
      }

      <a class="button button-secondary" href={route("cv", lang)}>
        {t.secondary}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-content {
    padding: clamp(2rem, 5vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        circle at 100% 0%,
        var(--color-primary-soft),
        transparent 55%
      ),
      var(--color-surface);
  }

  .cta-content h2 {
    margin-bottom: 1.25rem;
  }

  .cta-description {
    max-width: 650px;
    margin-bottom: 2rem;
    color: var(--color-text-secondary);
    font-size: 1.1rem;
  }
</style>
