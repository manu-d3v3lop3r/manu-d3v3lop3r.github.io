---
import ProjectCard from "../projects/ProjectCard.astro";
import {
  projectHref,
  projectTypeLabels,
  route,
  type Lang,
} from "../../i18n/utils";
import { getProjects } from "../../utils/projects";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const projects = await getProjects(lang, { featured: true });

const t =
  lang === "es"
    ? {
        eyebrow: "Proyectos destacados",
        title: "Trabajo seleccionado",
        description:
          "Casos de estudio con el contexto, el problema, la solución y mi papel en cada proyecto.",
        technologiesLabel: "Tecnologías utilizadas",
        linkLabel: "Leer caso de estudio",
        allProjects: "Ver todos los proyectos",
        empty: "Todavía no hay proyectos destacados.",
      }
    : {
        eyebrow: "Featured projects",
        title: "Selected work",
        description:
          "Case studies covering the context, the problem, the solution and my role in each project.",
        technologiesLabel: "Technologies used",
        linkLabel: "Read case study",
        allProjects: "View all projects",
        empty: "There are no featured projects yet.",
      };
---

<section class="section container" aria-labelledby="selected-work-title">
  <header class="section-header">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="selected-work-title">{t.title}</h2>
    <p>{t.description}</p>
  </header>

  {
    projects.length > 0 ? (
      <div class="card-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            summary={project.data.summary}
            type={projectTypeLabels[project.data.type][lang]}
            technologies={project.data.technologies}
            technologiesLabel={t.technologiesLabel}
            href={projectHref(lang, project.data)}
            linkLabel={t.linkLabel}
          />
        ))}
      </div>
    ) : (
      <p class="card">{t.empty}</p>
    )
  }

  <div class="section-action">
    <a class="text-link" href={route("projects", lang)}>
      {t.allProjects} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
