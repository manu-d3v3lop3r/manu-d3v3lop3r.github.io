---
interface Props {
  title: string;
  summary: string;
  type: string;
  technologies: string[];
  technologiesLabel: string;
  href: string;
  linkLabel: string;
  headingLevel?: "h2" | "h3";
  maxTechnologies?: number;
}

const {
  title,
  summary,
  type,
  technologies,
  technologiesLabel,
  href,
  linkLabel,
  headingLevel: Heading = "h3",
  maxTechnologies = 7,
} = Astro.props;

const visibleTechnologies = technologies.slice(0, maxTechnologies);
const hiddenCount = technologies.length - visibleTechnologies.length;
---

<article class="project-card">
  <p class="project-type">{type}</p>

  <Heading class="project-title">
    <a href={href}>{title}</a>
  </Heading>

  <p class="project-summary">{summary}</p>

  <ul class="tag-list" aria-label={technologiesLabel}>
    {visibleTechnologies.map((technology) => <li>{technology}</li>)}
    {hiddenCount > 0 && <li>+{hiddenCount}</li>}
  </ul>

  <span class="project-link" aria-hidden="true">
    {linkLabel}
    <span class="project-link-arrow">→</span>
  </span>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-border-strong);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.35);
    transform: translateY(-2px);
  }

  .project-type {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-title {
    margin-bottom: 0.85rem;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
  }

  .project-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Makes the whole card clickable while keeping a single, meaningful link. */
  .project-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-title a:focus-visible {
    box-shadow: none;
  }

  .project-card:has(.project-title a:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .project-summary {
    margin-bottom: 1.5rem;
    color: var(--color-text-secondary);
  }

  .tag-list {
    margin-bottom: 1.75rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
  }

  .project-link-arrow {
    transition: transform 160ms ease;
  }

  .project-card:hover .project-link-arrow {
    transform: translateX(0.25rem);
  }

  @media (max-width: 700px) {
    .project-card {
      padding: 1.5rem;
    }
  }
</style>
