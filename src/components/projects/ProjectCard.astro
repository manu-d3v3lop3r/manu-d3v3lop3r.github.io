---
interface Props {
  title: string;
  summary: string;
  type: string;
  technologies: string[];
  technologiesLabel: string;
  href: string;
  linkLabel: string;
}

const {
  title,
  summary,
  type,
  technologies,
  technologiesLabel,
  href,
  linkLabel,
} = Astro.props;
---

<article class="project-card">
  <div class="project-card-content">
    <p class="project-type">{type}</p>

    <h2>
      <a href={href}>{title}</a>
    </h2>

    <p class="project-summary">{summary}</p>

    <ul class="technologies" aria-label={technologiesLabel}>
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>

    <a class="project-link" href={href}>
      <span>{linkLabel}</span>
      <span class="project-link-arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .project-card:hover {
    border-color: var(--color-text-muted);
    transform: translateY(-2px);
  }

  .project-card-content {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 2rem;
  }

  .project-type {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-card h2 {
    margin-bottom: 1rem;
  }

  .project-card h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .project-card h2 a:hover {
    color: var(--color-primary);
  }

  .project-summary {
    margin-bottom: 1.5rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .technologies li {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .project-link:hover {
    color: var(--color-primary-hover);
  }

  .project-link-arrow {
    transition: transform 160ms ease;
  }

  .project-link:hover .project-link-arrow {
    transform: translateX(0.2rem);
  }

  @media (max-width: 700px) {
    .project-card-content {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-link-arrow {
      transition: none;
    }
  }
</style>
