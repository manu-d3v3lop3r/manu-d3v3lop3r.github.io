---
interface Props {
  title: string;
  summary: string;
  type: string;
  technologies: string[];
  technologiesLabel: string;
  href: string;
  linkLabel: string;
}

const {
  title,
  summary,
  type,
  technologies,
  technologiesLabel,
  href,
  linkLabel,
} = Astro.props;
---

<article class="project-card">
  <div class="project-card-content">
    <p class="project-type">{type}</p>

    <h2>{title}</h2>

    <p>{summary}</p>

    <ul class="technologies" aria-label={technologiesLabel}>
      {technologies.map((technology) => <li>{technology}</li>)}
    </ul>

    <a class="project-link" href={href}>
      {linkLabel}
    </a>
  </div>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .project-card-content {
    padding: 2rem;
  }

  .project-type {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .project-card h2 {
    margin-bottom: 1rem;
  }

  .project-card p {
    margin-bottom: 1.5rem;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .technologies li {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .project-link {
    color: var(--color-primary);
    font-weight: 600;
  }

  .project-link:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 700px) {
    .project-card-content {
      padding: 1.5rem;
    }
  }
</style>
