---
import { getAlternates, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const alternates = getAlternates(Astro.url.pathname);

const options = [
  { code: "es", label: "ES", name: "Español" },
  { code: "en", label: "EN", name: "English" },
] as const;

const groupLabel = lang === "es" ? "Idioma" : "Language";
---

<div class="language-switcher" role="group" aria-label={groupLabel}>
  {
    options.map((option) =>
      option.code === lang ? (
        <span class="is-current" aria-current="true" title={option.name}>
          <span aria-hidden="true">{option.label}</span>
          <span class="visually-hidden">{option.name}</span>
        </span>
      ) : (
        <a
          href={alternates?.[option.code] ?? `/${option.code}/`}
          hreflang={option.code}
          lang={option.code}
          title={option.name}
        >
          <span aria-hidden="true">{option.label}</span>
          <span class="visually-hidden">{option.name}</span>
        </a>
      ),
    )
  }
</div>

<style>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .language-switcher > * {
    display: inline-flex;
    min-width: 2.25rem;
    min-height: 2.15rem;
    align-items: center;
    justify-content: center;
    border-radius: calc(var(--radius-md) - 3px);
  }

  .is-current {
    background: var(--color-surface-subtle);
    color: var(--color-text);
  }

  a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }
</style>
