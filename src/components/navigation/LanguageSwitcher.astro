---
import { localeRoutes } from "../../data/locales";

interface Props {
  lang: "es" | "en";
}

const { lang } = Astro.props;

const targetLang = lang === "es" ? "en" : "es";
const targetLabel = lang === "es" ? "English" : "Español";
const currentLabel = lang === "es" ? "Español" : "English";

const currentPath = Astro.url.pathname;

const routeEntry = Object.values(localeRoutes).find(
  (route) => route.es === currentPath || route.en === currentPath,
);

const targetPath = routeEntry
  ? routeEntry[targetLang]
  : targetLang === "es"
    ? "/es/"
    : "/en/";
---

<div
  class="language-switcher"
  aria-label={lang === "es" ? "Selector de idioma" : "Language selector"}
>
  <span class="current-language">
    {currentLabel}
  </span>

  <a href={targetPath} hreflang={targetLang}>
    {targetLabel}
  </a>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .current-language {
    color: var(--color-text);
    font-weight: 600;
  }

  a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--color-text);
  }
</style>
