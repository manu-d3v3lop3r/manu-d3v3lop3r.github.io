---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { certifications, education, person } from "../../data/profile";
import type { Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const certificationCount = certifications.reduce(
  (total, group) => total + group.items.length,
  0,
);

const t =
  lang === "es"
    ? {
        title: `Formación y certificaciones | ${person.name}`,
        description:
          "Formación de Manuel Jiménez: Técnico Superior en DAM, Máster en Full Stack Development y certificaciones en Java, Python, JavaScript, IA y ciberseguridad.",
        eyebrow: "Formación",
        heading: "Formación y aprendizaje continuo",
        intro:
          "Formación reglada, especialización y certificaciones para seguir ampliando conocimientos en desarrollo de software, inteligencia artificial y herramientas de productividad.",
        educationTitle: "Formación académica",
        certificationsTitle: "Certificaciones y cursos",
        certificationsIntro: `${certificationCount} cursos completados en plataformas como Cisco Networking Academy, Google, MoureDev, Founderz y ODILO.`,
        approachTitle: "Aprendizaje aplicado",
        approach: [
          "Gran parte de lo que sé lo he aprendido resolviendo problemas concretos en proyectos reales: aprendí Power Automate desde cero para automatizar un proceso, Magnolia CMS para migrar un portal, y a configurar Apache, PHP y MySQL para poner en producción una aplicación.",
          "Mi forma de aprender es entender el problema, investigar alternativas, probar una solución y adaptarla al entorno real. Ahora mismo sigo profundizando en desarrollo backend y en buenas prácticas de arquitectura y testing.",
        ],
      }
    : {
        title: `Education & certifications | ${person.name}`,
        description:
          "Manuel Jiménez's education: Higher Vocational Diploma in Multiplatform Application Development, Master in Full Stack Development and certifications in Java, Python, JavaScript, AI and cybersecurity.",
        eyebrow: "Education",
        heading: "Education and continuous learning",
        intro:
          "Formal education, specialisation and certifications to keep expanding my knowledge in software development, artificial intelligence and productivity tools.",
        educationTitle: "Formal education",
        certificationsTitle: "Certifications & courses",
        certificationsIntro: `${certificationCount} completed courses on platforms such as Cisco Networking Academy, Google, MoureDev, Founderz and ODILO.`,
        approachTitle: "Applied learning",
        approach: [
          "Much of what I know I learned solving concrete problems in real projects: I learned Power Automate from scratch to automate a process, Magnolia CMS to migrate a portal, and how to configure Apache, PHP and MySQL to put an application into production.",
          "My way of learning is to understand the problem, research alternatives, try a solution and adapt it to the real environment. I'm currently going deeper into backend development and good practices in architecture and testing.",
        ],
      };
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <div class="page container">
    <header class="page-header">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.heading}</h1>
      <p class="lead">{t.intro}</p>
    </header>

    <section class="learning-section" aria-labelledby="education-title">
      <h2 id="education-title">{t.educationTitle}</h2>

      <div class="education-list">
        {
          education.map((item) => (
            <article class="card">
              <h3>{item.title[lang]}</h3>
              <p class="meta">
                {item.institution} · {item.detail[lang]} · {item.period[lang]}
              </p>
              <p class="description">{item.description[lang]}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="learning-section" aria-labelledby="certifications-title">
      <h2 id="certifications-title">{t.certificationsTitle}</h2>
      <p class="section-intro">{t.certificationsIntro}</p>

      <div class="card-grid">
        {
          certifications.map((group) => (
            <section class="card">
              <h3>{group.title[lang]}</h3>
              <ul class="cert-list">
                {group.items.map((item) => (
                  <li>
                    <span>{item.title[lang]}</span>
                    <span class="meta">{item.provider}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="learning-section" aria-labelledby="approach-title">
      <h2 id="approach-title">{t.approachTitle}</h2>
      <div class="approach">
        {t.approach.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .learning-section {
    padding-block: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  .learning-section h2 {
    margin-bottom: 1.75rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .section-intro {
    margin: -0.75rem 0 2rem;
    color: var(--color-text-secondary);
  }

  .education-list {
    display: grid;
    gap: 1rem;
    max-width: 920px;
  }

  .education-list h3 {
    margin-bottom: 0.4rem;
  }

  .description {
    margin-top: 1rem;
    color: var(--color-text-secondary);
  }

  .card > h3 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .cert-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .cert-list .meta {
    flex-shrink: 0;
  }

  .approach {
    display: grid;
    gap: 1.25rem;
    max-width: 760px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 700px) {
    .learning-section {
      padding-block: 2.5rem;
    }
  }
</style>
