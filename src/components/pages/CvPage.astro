---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contact } from "../../data/contact";
import {
  certifications,
  cvPdf,
  education,
  experience,
  person,
  skillLabel,
  skills,
  spokenLanguages,
} from "../../data/profile";
import { projectHref, type Lang } from "../../i18n/utils";
import { getProjects } from "../../utils/projects";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const projects = await getProjects(lang);
const site = Astro.site ?? Astro.url;

const t =
  lang === "es"
    ? {
        title: `CV | ${person.name}`,
        description:
          "Currículum de Manuel Jiménez, desarrollador de software en Madrid: experiencia, formación, stack técnico, certificaciones e idiomas.",
        eyebrow: "Currículum",
        print: "Imprimir",
        download: "Descargar PDF",
        profile: "Perfil",
        summary:
          "Desarrollador Full Stack formado en DAM y en un máster de Full Stack, con experiencia en el sector público. Desarrollo APIs REST con Java y Spring Boot (Spring Security, JWT, JPA, tests con JUnit y Mockito), he llevado desde cero hasta producción una aplicación web de gestión documental (PHP, MySQL, JavaScript) y he automatizado procesos administrativos con Power Automate. Orientado a entender el problema, documentar y entregar software que se utiliza.",
        experience: "Experiencia",
        education: "Formación",
        skills: "Stack técnico",
        projects: "Proyectos",
        certifications: "Certificaciones",
        languages: "Idiomas",
        portfolio: "Portfolio",
      }
    : {
        title: `CV | ${person.name}`,
        description:
          "CV of Manuel Jiménez, Madrid-based software developer: experience, education, tech stack, certifications and languages.",
        eyebrow: "Résumé",
        print: "Print",
        download: "Download PDF",
        profile: "Profile",
        summary:
          "Full Stack Developer trained in Multiplatform Application Development and a Full Stack master's, with public-sector experience. I build REST APIs with Java and Spring Boot (Spring Security, JWT, JPA, JUnit and Mockito tests), took a document management web app from scratch to production (PHP, MySQL, JavaScript) and automated administrative processes with Power Automate. Focused on understanding the problem, documenting and delivering software that gets used.",
        experience: "Experience",
        education: "Education",
        skills: "Tech stack",
        projects: "Projects",
        certifications: "Certifications",
        languages: "Languages",
        portfolio: "Portfolio",
      };

const displayUrl = (url: string) =>
  url.replace(/^https?:\/\//, "").replace(/\/$/, "");
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <article class="cv container">
    <header class="cv-header">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{person.name}</h1>
        <p class="cv-role">{person.role[lang]}</p>
        <p class="cv-availability">{person.availability[lang]}</p>

        <ul class="cv-contact">
          <li>{person.location[lang]}</li>
          {
            contact.email && (
              <li>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
            )
          }
          <li>
            <a href={contact.linkedin}>LinkedIn</a>
          </li>
          <li>
            <a href={contact.github}>{displayUrl(contact.github)}</a>
          </li>
          <li class="print-only">
            {t.portfolio}: {displayUrl(site.origin)}
          </li>
        </ul>
      </div>

      <div class="cv-actions no-print">
      <a class="button button-primary" href={cvPdf[lang]} download>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 21h14"></path>
        </svg>
        {t.download}
      </a>
      <button class="button button-secondary" type="button" data-print>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"></path>
        </svg>
        {t.print}
      </button>
      </div>
    </header>

    <section class="cv-section">
      <h2>{t.profile}</h2>
      <p class="cv-summary">{t.summary}</p>
    </section>

    <section class="cv-section">
      <h2>{t.experience}</h2>

      <div class="cv-entries">
        {
          experience.map((job) => (
            <article class="cv-entry">
              <header>
                <div>
                  <h3>{job.role[lang]}</h3>
                  <p class="cv-entry-org">
                    {job.company} · {job.contractType[lang]}
                  </p>
                </div>
                <p class="meta">
                  {job.period[lang]} · {job.location[lang]}
                </p>
              </header>
              <ul>
                {job.areas
                  .flatMap((area) => area.items[lang])
                  .map((item) => (
                    <li>{item}</li>
                  ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2>{t.education}</h2>

      <div class="cv-entries">
        {
          education.map((item) => (
            <article class="cv-entry">
              <header>
                <div>
                  <h3>{item.title[lang]}</h3>
                  <p class="cv-entry-org">
                    {item.institution} · {item.detail[lang]}
                  </p>
                </div>
                <p class="meta">{item.period[lang]}</p>
              </header>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section">
      <h2>{t.skills}</h2>

      <dl class="cv-skills">
        {
          skills.map((group) => (
            <div>
              <dt>{group.title[lang]}</dt>
              <dd>
                {group.items.map((item) => skillLabel(item, lang)).join(" · ")}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>{t.projects}</h2>

      <ul class="cv-projects">
        {
          projects.map((project) => (
            <li>
              <a href={projectHref(lang, project.data)}>{project.data.title}</a>
              <span>{project.data.summary}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="cv-columns">
      <section class="cv-section">
        <h2>{t.certifications}</h2>
        <ul class="cv-certs">
          {
            certifications
              .flatMap((group) => group.items)
              .map((item) => (
                <li>
                  {item.title[lang]} <span class="meta">· {item.provider}</span>
                </li>
              ))
          }
        </ul>
      </section>

      <section class="cv-section">
        <h2>{t.languages}</h2>
        <dl class="cv-languages">
          {
            spokenLanguages.map((language) => (
              <div>
                <dt>{language.name[lang]}</dt>
                <dd>{language.level[lang]}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-print]")
    .forEach((button) => button.addEventListener("click", () => window.print()));
</script>

<style>
  .cv {
    max-width: 960px;
    padding-block: 4rem 2rem;
  }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-text);
  }

  .cv-header h1 {
    max-width: none;
    margin-bottom: 0.25rem;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }

  .cv-role {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .cv-availability {
    margin: -0.75rem 0 1rem;
    color: #15803d;
    font-size: 0.925rem;
    font-weight: 600;
  }

  :global(html[data-theme="dark"]) .cv-availability {
    color: #4ade80;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cv-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-secondary);
    font-size: 0.925rem;
  }

  .cv-contact a {
    color: inherit;
  }

  .print-only {
    display: none;
  }

  .cv-section {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cv-section h2 {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cv-summary {
    max-width: none;
  }

  .cv-entries {
    display: grid;
    gap: 2rem;
  }

  .cv-entry header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .cv-entry h3 {
    font-size: 1.1rem;
  }

  .cv-entry-org {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .cv-entry header .meta {
    flex-shrink: 0;
  }

  .cv-entry ul {
    margin: 0;
    padding-left: 1.15rem;
    color: var(--color-text-secondary);
  }

  .cv-entry li + li {
    margin-top: 0.35rem;
  }

  .cv-skills {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .cv-skills div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
  }

  .cv-skills dt {
    font-weight: 600;
  }

  .cv-skills dd {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .cv-projects {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-projects a {
    display: block;
    color: var(--color-text);
    font-weight: 600;
  }

  .cv-projects span {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .cv-columns {
    display: grid;
  }

  .cv-certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .cv-languages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    margin: 0;
  }

  .cv-languages dt {
    font-weight: 600;
  }

  .cv-languages dd {
    margin: 0;
    color: var(--color-text-secondary);
  }

  @media (max-width: 760px) {
    .cv {
      padding-block: 3rem 1rem;
    }

    .cv-header {
      flex-direction: column;
      align-items: stretch;
    }

    .cv-section,
    .cv-skills div {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .cv-section {
      gap: 1.25rem;
    }

    .cv-entry header {
      flex-direction: column;
      gap: 0.25rem;
    }

    .cv-certs {
      grid-template-columns: 1fr;
    }
  }

  /* ----------------------------- Print / PDF ----------------------------- */

  @media print {
    @page {
      size: A4;
      margin: 14mm 14mm 16mm;
    }

    :global(html),
    :global(body) {
      background: #fff !important;
      color: #111 !important;
      font-size: 10pt;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .no-print {
      display: none !important;
    }

    .print-only {
      display: list-item;
      list-style: none;
    }

    .cv {
      width: 100%;
      max-width: none;
      padding: 0;
    }

    .cv-header {
      padding-bottom: 10pt;
      border-bottom-color: #111;
    }

    .cv-header h1 {
      font-size: 22pt;
    }

    .cv-role {
      margin-bottom: 6pt;
      font-size: 12pt;
      color: #1d4ed8;
    }

    .cv-availability {
      margin: -3pt 0 6pt;
      color: #15803d !important;
      font-size: 10pt;
    }

    .cv-section {
      grid-template-columns: 30mm minmax(0, 1fr);
      gap: 6mm;
      padding-block: 8pt;
      border-bottom-color: #ddd;
      break-inside: avoid;
    }

    .cv-section:has(.cv-entries) {
      break-inside: auto;
    }

    .cv-entry {
      break-inside: avoid;
    }

    .cv-entries {
      gap: 8pt;
    }

    .cv-entry h3 {
      font-size: 11pt;
    }

    .cv-skills div {
      grid-template-columns: 34mm minmax(0, 1fr);
      gap: 4mm;
    }

    .cv-entry ul,
    .cv-skills dd,
    .cv-projects span,
    .cv-entry-org,
    .cv-languages dd {
      color: #333 !important;
    }

    .cv a {
      color: #111 !important;
      text-decoration: none;
    }

    :global(p) {
      max-width: none;
      line-height: 1.45;
    }
  }
</style>
